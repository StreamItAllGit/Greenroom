<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GreenroomVersion Condition="'$(GreenroomVersion)' == ''">0.3.0</GreenroomVersion>
    <GreenroomNuGetVersion Condition="'$(GreenroomNuGetVersion)' == ''">$(GreenroomVersion)</GreenroomNuGetVersion>
    <GreenroomFileVersion Condition="'$(GreenroomFileVersion)' == ''">0.3.0.0</GreenroomFileVersion>
    <InstallerDeliveryKind Condition="'$(InstallerDeliveryKind)' == '' and '$(InstallerPayloadZip)' != ''">offlineSetup</InstallerDeliveryKind>
    <InstallerDeliveryKind Condition="'$(InstallerDeliveryKind)' == ''">onlineSetup</InstallerDeliveryKind>
    <ApplicationIcon Condition="Exists('..\..\assets\Greenroom.ico')">..\..\assets\Greenroom.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == '' and Exists('..\..\greenroom\companion\static\icons\greenroom.ico')">..\..\greenroom\companion\static\icons\greenroom.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Greenroom-Setup</AssemblyName>
    <RootNamespace>Greenroom.Installer</RootNamespace>
    <Product>Greenroom</Product>
    <Company>StreamItAll</Company>
    <AssemblyTitle>Greenroom Setup</AssemblyTitle>
    <Description>Self-contained single-EXE installer and uninstaller for Greenroom</Description>
    <Version>$(GreenroomNuGetVersion)</Version>
    <InformationalVersion>$(GreenroomVersion)</InformationalVersion>
    <AssemblyVersion>$(GreenroomFileVersion)</AssemblyVersion>
    <FileVersion>$(GreenroomFileVersion)</FileVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))=/_/</PathMap>
    <EffectiveInstallerManifestJson Condition="'$(InstallerManifestJson)' != '' and Exists('$(InstallerManifestJson)')">$(InstallerManifestJson)</EffectiveInstallerManifestJson>
    <EffectiveInstallerManifestJson Condition="'$(EffectiveInstallerManifestJson)' == '' and Exists('installer.manifest.json')">installer.manifest.json</EffectiveInstallerManifestJson>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(InstallerDeliveryKind)').Equals('onlineSetup', System.StringComparison.OrdinalIgnoreCase))">
    <InstallerDeliveryKind>onlineSetup</InstallerDeliveryKind>
    <DefineConstants>$(DefineConstants);GREENROOM_ONLINE_SETUP</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([System.String]::Copy('$(InstallerDeliveryKind)').Equals('offlineSetup', System.StringComparison.OrdinalIgnoreCase))">
    <InstallerDeliveryKind>offlineSetup</InstallerDeliveryKind>
    <DefineConstants>$(DefineConstants);GREENROOM_OFFLINE_SETUP</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' or '$(GreenroomTestAutomation)' == 'true'">
    <DefineConstants>$(DefineConstants);GREENROOM_TEST_AUTOMATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Greenroom.Installer.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyMetadata Include="Greenroom.InstallerDeliveryKind" Value="$(InstallerDeliveryKind)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Foundation.Core">
      <HintPath>..\..\lib\Foundation.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Foundation.Installer">
      <HintPath>..\..\lib\Foundation.Installer.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug' or '$(GreenroomTestAutomation)' == 'true'">
    <Reference Include="Foundation.UI">
      <HintPath>..\..\lib\Foundation.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Foundation.Automation">
      <HintPath>..\..\lib\Foundation.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CompressFoundationAssemblies"
          BeforeTargets="AssignTargetPaths;PrepareResourceNames;PrepareResources">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;foreach ($n in @('Foundation.Core.dll','Foundation.Installer.dll')) { $src = Join-Path '$(MSBuildProjectDirectory)\..\..\lib' $n; $dst = Join-Path ([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)')) ($n + '.gz'); $inBytes = [System.IO.File]::ReadAllBytes($src); $fs = [System.IO.File]::Create($dst); try { $gz = New-Object System.IO.Compression.GZipStream($fs, [System.IO.Compression.CompressionLevel]::Optimal); try { $gz.Write($inBytes, 0, $inBytes.Length) } finally { $gz.Dispose() } } finally { $fs.Dispose() } }&quot;" />
    <ItemGroup>
      <EmbeddedResource Remove="$(IntermediateOutputPath)Foundation.Core.dll.gz;$(IntermediateOutputPath)Foundation.Installer.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.Core.dll.gz" LogicalName="Foundation.Core.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.Installer.dll.gz" LogicalName="Foundation.Installer.dll.gz" />
    </ItemGroup>
  </Target>

  <Target Name="CompressFoundationAutomationAssemblies"
          BeforeTargets="AssignTargetPaths;PrepareResourceNames;PrepareResources"
          Condition="'$(Configuration)' == 'Debug' or '$(GreenroomTestAutomation)' == 'true'">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;foreach ($n in @('Foundation.UI.dll','Foundation.Automation.dll')) { $src = Join-Path '$(MSBuildProjectDirectory)\..\..\lib' $n; $dst = Join-Path ([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)')) ($n + '.gz'); $inBytes = [System.IO.File]::ReadAllBytes($src); $fs = [System.IO.File]::Create($dst); try { $gz = New-Object System.IO.Compression.GZipStream($fs, [System.IO.Compression.CompressionLevel]::Optimal); try { $gz.Write($inBytes, 0, $inBytes.Length) } finally { $gz.Dispose() } } finally { $fs.Dispose() } }&quot;" />
    <ItemGroup>
      <EmbeddedResource Remove="$(IntermediateOutputPath)Foundation.UI.dll.gz;$(IntermediateOutputPath)Foundation.Automation.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.UI.dll.gz" LogicalName="Foundation.UI.dll.gz" />
      <EmbeddedResource Include="$(IntermediateOutputPath)Foundation.Automation.dll.gz" LogicalName="Foundation.Automation.dll.gz" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="Exists('$(EffectiveInstallerManifestJson)')">
    <EmbeddedResource Include="$(EffectiveInstallerManifestJson)"
                      LogicalName="Greenroom.Installer.Embedded.installer.manifest.json" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\assets\Greenroom.png')">
    <EmbeddedResource Include="..\..\assets\Greenroom.png"
                      LogicalName="Greenroom.Installer.Assets.logo.png" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\assets\Greenroom.png') and Exists('..\..\greenroom\companion\static\icons\icon-192.png')">
    <EmbeddedResource Include="..\..\greenroom\companion\static\icons\icon-192.png"
                      LogicalName="Greenroom.Installer.Assets.logo.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(InstallerDeliveryKind)' != 'onlineSetup' and '$(InstallerPayloadZip)' != '' and Exists('$(InstallerPayloadZip)')">
    <EmbeddedResource Include="$(InstallerPayloadZip)"
                      LogicalName="Greenroom.Installer.Embedded.payload.zip" />
  </ItemGroup>

  <ItemGroup Condition="'$(InstallerDeliveryKind)' != 'onlineSetup' and '$(InstallerPayloadMeta)' != '' and Exists('$(InstallerPayloadMeta)')">
    <EmbeddedResource Include="$(InstallerPayloadMeta)"
                      LogicalName="Greenroom.Installer.Embedded.payload-meta.json" />
  </ItemGroup>

</Project>
